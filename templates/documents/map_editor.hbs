<div class="document-editor-sheet flexcol">
<div class="document-editor-scroll">
  <p class="notes">{{localize "dc.containers.doc.editor_saved_hint"}}</p>

  {{{quickfill_html}}}

  <div class="form-group">
    <label>{{localize "dc.containers.doc.map_title"}}</label>
    <input type="text" name="title" value="{{doc_data.title}}" />
  </div>
  <div class="form-group">
    <label>{{localize "dc.containers.doc.map_scale"}}</label>
    <input type="text" name="scale_label" value="{{doc_data.scale_label}}" />
  </div>
  <div class="form-group">
    <label>{{localize "dc.containers.doc.image"}}</label>
    <div class="flexrow">
      <input type="text" name="image" value="{{doc_data.image}}" class="flex1" />
      <button type="button" data-action="pickImage"><i class="fas fa-image"></i> {{localize "dc.containers.doc.map_pick_image"}}</button>
    </div>
  </div>

  <p class="notes">{{localize "dc.containers.doc.map_click_hint"}}</p>
  <div class="map-editor-preview">
    {{#if doc_data.image}}
    <img class="map-editor-preview-img" src="{{doc_data.image}}" alt="{{doc_data.title}}" />
    {{#each doc_data.markers as |marker index|}}
    <span class="map-editor-marker" style="left: {{marker.x_pct}}%; top: {{marker.y_pct}}%;"><i class="fas {{marker.icon}}"></i></span>
    {{/each}}
    {{else}}
    <div class="document-placeholder"><i class="fas fa-map"></i></div>
    {{/if}}
  </div>

  {{#each doc_data.markers as |marker index|}}
  <div class="flexrow map-marker-row">
    <span>{{marker.x_pct}}%, {{marker.y_pct}}%</span>
    <input type="text" name="marker_label_{{index}}" value="{{marker.label}}" placeholder="{{localize "dc.containers.doc.map_marker_label"}}" class="flex1" />
    <select name="marker_icon_{{index}}">
      <option value="fa-location-dot" {{#if (eq marker.icon "fa-location-dot")}}selected{{/if}}>Location</option>
      <option value="fa-flag" {{#if (eq marker.icon "fa-flag")}}selected{{/if}}>Flag</option>
      <option value="fa-flag-checkered" {{#if (eq marker.icon "fa-flag-checkered")}}selected{{/if}}>Finish</option>
      <option value="fa-home" {{#if (eq marker.icon "fa-home")}}selected{{/if}}>Building</option>
      <option value="fa-star" {{#if (eq marker.icon "fa-star")}}selected{{/if}}>Star (Sheriff)</option>
      <option value="fa-beer-mug-empty" {{#if (eq marker.icon "fa-beer-mug-empty")}}selected{{/if}}>Saloon</option>
      <option value="fa-store" {{#if (eq marker.icon "fa-store")}}selected{{/if}}>Store</option>
      <option value="fa-staff-snake" {{#if (eq marker.icon "fa-staff-snake")}}selected{{/if}}>Doctor</option>
      <option value="fa-horse" {{#if (eq marker.icon "fa-horse")}}selected{{/if}}>Horse</option>
      <option value="fa-train" {{#if (eq marker.icon "fa-train")}}selected{{/if}}>Train</option>
      <option value="fa-tint" {{#if (eq marker.icon "fa-tint")}}selected{{/if}}>Water</option>
      <option value="fa-mountain" {{#if (eq marker.icon "fa-mountain")}}selected{{/if}}>Mountain</option>
      <option value="fa-hammer" {{#if (eq marker.icon "fa-hammer")}}selected{{/if}}>Mine</option>
      <option value="fa-door-open" {{#if (eq marker.icon "fa-door-open")}}selected{{/if}}>Entrance</option>
      <option value="fa-arrow-down" {{#if (eq marker.icon "fa-arrow-down")}}selected{{/if}}>Down</option>
      <option value="fa-shield" {{#if (eq marker.icon "fa-shield")}}selected{{/if}}>Fort</option>
      <option value="fa-triangle-exclamation" {{#if (eq marker.icon "fa-triangle-exclamation")}}selected{{/if}}>Hazard</option>
      <option value="fa-skull" {{#if (eq marker.icon "fa-skull")}}selected{{/if}}>Danger</option>
      <option value="fa-treasure-chest" {{#if (eq marker.icon "fa-treasure-chest")}}selected{{/if}}>Treasure</option>
    </select>
    <button type="button" data-action="removeMarker" data-index="{{index}}"><i class="fas fa-trash"></i></button>
  </div>
  {{/each}}
  <button type="button" data-action="addMarker"><i class="fas fa-plus"></i> {{localize "dc.containers.doc.map_add_marker"}}</button>

  {{#if preview_html}}
  <div class="document-editor-preview-panel">
    <h4>{{localize "dc.containers.doc.document_preview"}}</h4>
    <div class="document-text">{{{preview_html}}}</div>
  </div>
  {{/if}}
</div>
<footer class="document-editor-footer flexrow">
  <button type="button" data-action="save"><i class="fas fa-save"></i> {{localize "dc.containers.doc.editor_save"}}</button>
  <button type="button" data-action="cancel">{{localize "dc.containers.doc.editor_cancel"}}</button>
</footer>
</div>

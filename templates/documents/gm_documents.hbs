<section>
  <a data-action="togglePath" class="toggle-path" data-path="tabs.gear.tabs.documents.hint" data-char="true"><div class="dc-newspaper-subhead">{{localize "dc.containers.doc.header"}}</div></a>
  {{#if (eq this.actor.system.tabs.gear.tabs.documents.hint true)}}
  <div class="dc-hint">{{localize_array "dc.containers.doc.hint" columns=true}}</div>
  {{/if}}

  {{!-- Template Gallery — injected by document_template_gallery.js --}}
  <div class="dc-doc-template-gallery-placeholder"></div>

  <div class="center">
    <a data-action="newPath" class="new-path bold" data-path="gear.documents">{{localize "dc.containers.doc.add"}}</a>
  </div>
  <div class="gear-search-bar"><i class="fas fa-search"></i><input type="text" class="gear-search" placeholder="{{localize "dc.shared.search_gear"}}" data-gear-search></div>
  <table>
    <tr>
      <th class="sort-list center" data-action="sortList" data-path="documents" data-key="quantity">{{localize "dc.shared.quantity_short"}}</th>
      <th class="sort-list center" data-action="sortList" data-path="documents" data-key="label">{{localize "dc.shared.name"}}</th>
      <th class="sort-list center" data-action="sortList" data-path="documents" data-key="category">{{localize "dc.shared.category"}}</th>
      <th class="sort-list center" data-action="sortList" data-path="documents" data-key="content_type" title="{{localize "dc.containers.doc.content_type"}}"><i class="fas fa-file" /></th>
      <th class="sort-list center" data-action="sortList" data-path="documents" data-key="weight" title="{{localize "dc.shared.weight"}}"><i class="fas fa-weight-hanging" /></th>
      <th class="sort-list center" data-action="sortList" data-path="documents" data-key="rarity" title="{{localize "dc.shared.rarity"}}"><i class="fas fa-gem" /></th>
      <th class="sort-list center" data-action="sortList" data-path="documents" data-key="cost" title="{{localize "dc.shared.cost"}}"><i class="fas fa-dollar-sign" /></th>
      <th class="center width-5" title="{{localize "dc.shared.read"}}"><i class="fas fa-book-open" /></th>
      <th class="center width-5" title="{{localize "dc.shared.edit"}}"><i class="fas fa-pen-nib" /></th>
      <th class="center width-5" title="{{localize "dc.shared.duplicate"}}"><i class="fas fa-copy" /></th>
      <th class="center width-5" title="{{localize "dc.shared.trash"}}"><i class="fas fa-trash" /></th>
    </tr>
    {{#each this.gear.documents as |doc|}}
      <tr>
        <td class="right pad-right-4">{{doc.quantity}}</td>
        <td class="left">{{doc.label}}</td>
        <td class="left">{{lookup_localization "dc.containers.doc.categories" doc.category}}</td>
        <td class="left pad-left-10">{{lookup_localization "dc.containers.doc.content_types" doc.content_type}}</td>
        <td class="right pad-right-4">{{doc.weight}}</td>
        <td class="left">{{lookup_localization "dc.equipment.rarity" doc.rarity}}</td>
        <td class="right">{{format_currency doc.cost}}</td>
        <td data-action="readDocument" class="center read-document" data-path="gear.documents" data-key="{{@key}}">
          <a class="fas fa-book-open" title="{{localize "dc.shared.read"}} {{doc.label}}" />
        </td>
        <td data-action="editPath" class="center edit-path" data-path="gear.documents" data-key="{{@key}}"><a class="fas fa-pen-nib" title="{{localize "dc.shared.edit"}} {{doc.label}}"/></td>
        <td data-action="duplicatePath" class="center duplicate-path" data-path="gear.documents" data-key="{{@key}}"><a class="fas fa-copy" title="{{localize "dc.shared.duplicate"}} {{doc.label}}"/></td>
        <td data-action="deletePath" class="center delete-path" data-path="gear.documents.{{@key}}"><a class="fas fa-trash" title="{{localize "dc.shared.trash"}} {{doc.label}}?"/></td>
      </tr>
    {{/each}}
  </table>
</section>